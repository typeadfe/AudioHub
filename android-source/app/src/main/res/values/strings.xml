    <string name="settings_security">安全</string>
    <string name="settings_approval">连接审批</string>
    <string name="settings_approval_hint">开启后，新设备接入不会立刻收到你的音频，需要你在「发送」页点【允许】。批准过的设备会自动放行，不再询问。\n\n关闭后任何设备连上即可接收音频（不安全，仅在完全可信的局域网里使用）。</string>
    <string name="settings_approved_devices">已批准的设备</string>
    <string name="settings_approved_none">还没有已批准的设备。</string>
    <string name="settings_approved_clear">全部撤销</string>
    <string name="no_receiver">还没有发现接收端。\n\n电脑端请运行 ahub-player.exe；手机端请在另一台设备上切到「接收」并点开始。\n\n注意：连接由接收端发起，所以电脑必须先运行起来，这里才能看到它。</string>
    <string name="log_section">运行日志</string>

    <!-- 接收端 -->
    <string name="player_hint">已有连接会保持并自动重连。只有点击“扫描设备”才查找新发送端，约需 5 秒。</string>
