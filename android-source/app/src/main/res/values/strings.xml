    <string name="source_hint">建议先把手机音量调到 0，再打开游戏 / 音乐；本机音量滑块可单独调整这一路的响度。</string>
    <string name="local_volume">本机音量</string>
    <string name="btn_reset_volume">重置</string>
    <string name="local_volume_hint">100% 为原音量。此处调整在手机端生效，接收端收到什么就是什么。</string>
    <string name="btn_start_capture">开始发送</string>
