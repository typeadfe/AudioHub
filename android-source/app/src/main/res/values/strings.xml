    <string name="settings_group_audio">音频</string>
    <string name="settings_group_about">关于</string>

    <string name="settings_device_name">设备显示名称</string>
    <string name="settings_device_name_hint">其他设备在列表里看到的就是这个名字。</string>
    <string name="settings_device_name_default">留空则使用：%1$s</string>

    <string name="settings_quality">音频质量与延迟</string>
    <string name="quality_low">低延迟</string>
    <string name="quality_balanced">均衡</string>
    <string name="quality_stable">稳定优先</string>
    <string name="quality_hint_low">由发送端同步到接收端，缓冲 %1$d ms。延迟最低，网络抖动时可能出现断续。</string>
    <string name="quality_hint_balanced">由发送端同步到接收端，缓冲 %1$d ms。日常使用推荐，兼顾延迟与稳定。</string>
    <string name="quality_hint_stable">由发送端同步到接收端，缓冲 %1$d ms。网络较差时更稳，但延迟明显增加。</string>
    <string name="quality_note_lossless">在发送端选择后，会同步到每个接收端；WiFi 音频由发送端统一设置，缓冲越大越抗抖动，延迟也越高。</string>

    <string name="settings_exclusive">独占音频输出</string>
    <string name="settings_exclusive_hint">开启后，本应用播放时其他应用的声音会被暂停；关闭则与本机其他声音同时播放。默认关闭。</string>

    <string name="settings_autoconnect">自动连接新设备</string>
    <string name="settings_autoconnect_hint">发现新发送端时自动连接。关闭后可在设备列表里手动勾选。</string>

    <string name="settings_bandwidth">发送带宽（WiFi）</string>
    <string name="bandwidth_note">此档位由发送端决定，接收端自动跟随。\n\n只作用于 WiFi：通过降低采样率和声道数减少带宽；低档位会损失高频。\n\n运行中修改会立即通知已连接的接收端。</string>

    <string name="settings_log">记录运行日志</string>
    <string name="settings_log_hint">默认关闭。日志用于排查问题，长期开启会持续占用内存与电量；关闭后各页面的日志区域将不再更新。</string>
    <string name="log_disabled_hint">运行日志已关闭。如需排查问题，请在「设置 → 记录运行日志」中打开。</string>

    <string name="settings_source_code">源代码</string>
    <string name="settings_source_unpublished">尚未发布</string>
    <string name="settings_version">版本 %1$s</string>
    <string name="settings_license">音频和剪贴板内容在已连接的局域网设备间传输。请只在可信网络中使用。</string>

