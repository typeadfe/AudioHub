/*
 * 版本资源与清单
 *
 * 这一段【很重要】，不是为了好看：
 *
 *   没有版本资源的 exe，在 Windows 的"无法验证发布者"对话框里只显示一个
 *   光秃秃的文件名；属性页里也是空白。这种"什么都没有"的二进制在杀软的
 *   启发式评分里是明显的扣分项 —— 它们和免杀木马的特征高度重合。
 *
 *   补上产品名、公司名、版本号、描述之后：
 *     - 用户在属性页里能看到这是什么、哪个版本
 *     - 杀软看到的是一个"有完整身份信息的应用程序"
 *
 * 注意：这不能替代代码签名。要让"无法验证发布者"彻底消失，
 * 唯一办法是购买代码签名证书（见 README 里的说明）。
 */

#include <windows.h>

// 应用程序清单（权限声明 + DPI 感知 + 支持的系统版本）
1 RT_MANIFEST "app.manifest"
101 ICON "audiohub.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0x0804 = 简体中文，1200 = Unicode 代码页
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "AudioHub"
            VALUE "FileDescription",  "AudioHub 局域网音频收发与混音"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "AudioHub"
            VALUE "LegalCopyright",   "版权归项目作者所有"
            VALUE "OriginalFilename", "AudioHub-Windows-v1.0.exe"
            VALUE "ProductName",      "AudioHub"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "把局域网内多台设备的声音汇聚到本机混音播放"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
